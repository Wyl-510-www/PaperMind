# 默认正式接线需要 MySQL 8.0+；先创建 memory_v2 数据库，再显式初始化表。
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=memory_v2
# 可选完整 SQLAlchemy URL。写入连接池当前支持 MySQL，SQLite 仅用于离线 Store 测试。
# MEMORY_V2_DB_URL=mysql+pymysql://user:password@localhost:3306/memory_v2?charset=utf8mb4

# Qdrant 默认 HTTP 端口为 6333；原代码使用 8701，部署时可映射 8701:6333。
QDRANT_HOST=localhost
QDRANT_PORT=8701
MEMORY_V2_QDRANT_URL=http://localhost:8701
COLLECTION_NAME=bench_memory_v2_core

# 模型凭据；不要把实际值提交到版本控制。
DASHSCOPE_API_KEY=
# BAILIAN_API_KEY 优先于 DASHSCOPE_API_KEY。
BAILIAN_API_KEY=
MODEL_QWEN=qwen3.5-plus
MODEL_QWEN_35_PLUS=qwen3.5-plus
MODEL_QWEN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_EMBEDDING_QWEN=text-embedding-v4
MODEL_EMBEDDING_QWEN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_EMBEDDING_QWEN_DIM=1536
# 原 QdrantManager 通过另一个入口读取建 collection 的维度，两者须一致。
EMBEDDING_DIM=1536
RERANKER_SILICONFLOW_API_KEY=
RERANKER_SILICONFLOW_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/rerank

MEMORY_V2_ENABLE=true
MEMORY_V2_WRITE_ENABLED=true
MEMORY_V2_READ_ENABLED=true
